---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProjectStats from '../components/ProjectStats.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import ProjectExplorer from '../components/ProjectExplorer.astro';
import ToolsSection from '../components/ToolsSection.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';

// Single source of truth: every section below is derived from this one list.
const projects = (await getCollection('projects'))
  .map((e) => e.data)
  .sort((a, b) => b.publishedAt.getTime() - a.publishedAt.getTime());

const featured = projects.filter((p) => p.featured).slice(0, 3);
const stats = {
  projects: projects.length,
  platforms: new Set(projects.map((p) => p.platform)).size,
  categories: new Set(projects.map((p) => p.category)).size,
};
const hasSamples = projects.some((p) => p.sample);
---
<BaseLayout>
  <Header showFeatured={featured.length > 0} />
  <main id="main">
    <div class="df-container">
      <Hero showFeatured={featured.length > 0}>
        <ProjectStats {...stats} />
        {
          hasSamples && (
            <p class="df-notice">
              <Icon name="info" />
              Sample projects for demonstration — links point to placeholder addresses.
            </p>
          )
        }
      </Hero>
    </div>
    <FeaturedProjects projects={featured} />
    <ProjectExplorer projects={projects} />
    <ToolsSection projects={projects} />
  </main>
  <Footer />
  <script>
    import '../scripts/site.js';
  </script>
</BaseLayout>
